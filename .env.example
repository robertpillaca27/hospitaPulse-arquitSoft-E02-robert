CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=hospitapulse
POSTGRES_USER=hospitapulse
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://hospitapulse:replace-with-a-local-development-password@localhost:5432/hospitapulse
REDIS_URL=redis://localhost:6379/0
REDIS_INDICATORS_TTL_SECONDS=60
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
ADMIN_FULL_NAME=Administrador HospitaPulse
ADMIN_EMAIL=admin@example.org
SESSION_COOKIE_SECURE=false
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
